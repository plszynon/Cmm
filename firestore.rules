rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(communityId) {
      return exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    // Community documents: anyone signed in can read (needed to check join codes
    // and to preview private communities before joining); only the owner can
    // edit/delete; anyone signed in can create (they become the owner).
    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        // allow memberCount increments from the join flow
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow delete: if isSignedIn() && request.auth.uid == memberId;
      }

      match /posts/{postId} {
        allow read: if isSignedIn() && isMember(communityId);
        allow create: if isSignedIn() && isMember(communityId) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Each user can only read/write their own membership index
    match /users/{userId} {
      match /myCommunities/{communityId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
